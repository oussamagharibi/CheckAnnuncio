# Copia questo file in ".env" e inserisci la tua chiave API Anthropic.
# Il file .env NON va mai committato (è già in .gitignore).

# Chiave API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Porta del server (opzionale in locale, su Railway viene impostata in automatico)
PORT=3000
